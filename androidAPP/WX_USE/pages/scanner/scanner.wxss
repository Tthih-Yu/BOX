page {
  width: 100%;
  height: 100%;
  background: #000000;
  overflow: hidden;
}

.scanner-page {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #000000;
  overflow: hidden;
}

.scanner-camera {
  position: absolute;
  left: 0;
  top: 0;
}

.mask {
  position: absolute;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.58);
}

.scan-frame {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.corner {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-color: #3bd0ff;
  border-style: solid;
  border-width: 0;
}

.corner-tl {
  left: -4rpx;
  top: -4rpx;
  border-top-width: 8rpx;
  border-left-width: 8rpx;
  border-top-left-radius: 14rpx;
}

.corner-tr {
  right: -4rpx;
  top: -4rpx;
  border-top-width: 8rpx;
  border-right-width: 8rpx;
  border-top-right-radius: 14rpx;
}

.corner-bl {
  left: -4rpx;
  bottom: -4rpx;
  border-bottom-width: 8rpx;
  border-left-width: 8rpx;
  border-bottom-left-radius: 14rpx;
}

.corner-br {
  right: -4rpx;
  bottom: -4rpx;
  border-bottom-width: 8rpx;
  border-right-width: 8rpx;
  border-bottom-right-radius: 14rpx;
}

.scanner-top {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 20rpx) 28rpx 0;
  color: #ffffff;
}

.scanner-title {
  font-size: 36rpx;
  font-weight: 600;
}

.scanner-close {
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  font-size: 28rpx;
}

.scanner-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 42rpx);
  color: #ffffff;
  text-align: center;
}

.scanner-hint {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.camera-error-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: #111827;
  color: #ffffff;
}

.camera-error-title {
  margin-bottom: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.camera-error-detail {
  margin-bottom: 34rpx;
  color: rgba(255, 255, 255, 0.78);
  text-align: center;
}

.camera-error-button {
  padding: 20rpx 54rpx;
  border-radius: 999rpx;
  background: #0f6bd8;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
