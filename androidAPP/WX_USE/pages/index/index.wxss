page {
  height: 100vh;
  background: #f5f7fa;
  color: #1f2933;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  background: #f5f7fa;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  color: inherit;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.55;
  color: inherit;
}

.button-hover {
  opacity: 0.72;
}

.main-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx 16rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #edf0f4;
}

.settings-header {
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.app-kicker {
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.2;
}

.app-title {
  color: #1f2933;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 700;
}

.top-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f6bd8;
  border: 2rpx solid #d5dde5;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(15, 107, 216, 0.08);
}

.settings-scroll {
  height: calc(100vh - 126rpx);
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-card,
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 41, 51, 0.06);
}

.form-card {
  margin-bottom: 20rpx;
}

.card-title {
  margin-bottom: 22rpx;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
}

.segmented {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #f0f3f6;
}

.segment-button {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: transparent;
  color: #52606d;
  font-weight: 500;
}

.segment-active {
  background: #0f6bd8;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(15, 107, 216, 0.18);
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #52606d;
  font-size: 26rpx;
}

.field-input {
  display: block;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d5dde5;
  border-radius: 14rpx;
  background: #fbfcfe;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #0f6bd8;
  background: #ffffff;
}

.device-status {
  margin: -4rpx 0 22rpx;
  font-size: 26rpx;
}

.status-ok {
  color: #0f6bd8;
}

.status-error {
  color: #d64545;
}

.device-model {
  color: #7b8794;
  font-size: 26rpx;
}

.result-card {
  padding: 24rpx;
  border-radius: 16rpx;
}

.result-ok {
  background: #e7f3ff;
  color: #124e8c;
}

.result-error {
  background: #fdecec;
  color: #9b2c2c;
}

.result-title {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.result-detail {
  white-space: pre-line;
  word-break: break-all;
}

.settings-actions,
.actions {
  display: flex;
  gap: 18rpx;
}

.settings-actions {
  margin-top: 8rpx;
}

.developer-card {
  margin-top: 20rpx;
  border: 2rpx solid #edf0f4;
  background: #fbfcfe;
}

.developer-line {
  margin-bottom: 8rpx;
  color: #52606d;
}

.developer-copy {
  margin-top: 12rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.6;
}

.primary-button,
.outline-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.primary-button {
  background: #0f6bd8;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 107, 216, 0.2);
}

.outline-button {
  background: #ffffff;
  color: #0f6bd8;
  border: 2rpx solid #d5dde5;
}

.main {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
  position: relative;
  overflow: hidden;
}

.main-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.22;
}

.main-header,
.main-content,
.bottom-bar {
  position: relative;
  z-index: 1;
}

.main-content {
  flex: 1;
  min-height: 0;
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}

.preview-card {
  margin-bottom: 18rpx;
}

.material-code {
  margin-bottom: 8rpx;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
  word-break: break-all;
}

.default-line {
  margin-bottom: 22rpx;
  color: #0f6bd8;
  font-weight: 500;
}

.dev-watermark {
  margin: 8rpx 0 12rpx;
  color: #aab2bf;
  font-size: 22rpx;
  text-align: center;
}

.input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.field-flex-135 {
  flex: 1.35;
}

.field-flex-65 {
  flex: 0.65;
}

.bottom-bar {
  flex: none;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 2rpx solid #edf0f4;
}

.scan-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 106rpx;
  border-radius: 20rpx;
  background-color: #0f6bd8;
  background: linear-gradient(135deg, #0f6bd8 0%, #0a4f9f 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(15, 107, 216, 0.24);
}

.scan-button-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 26rpx;
  line-height: 1;
}

.keyboard-spacer {
  width: 100%;
}

.page-shell {
  width: 100%;
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
}

.page-shell .header {
  flex-shrink: 0;
  background: #ffffff;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.setting-btn {
  width: 360rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  color: #1677ff;
  background: #ffffff;
  border: 2rpx solid #d5dde5;
}

.status-card {
  margin: 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  background: #e8f3ff;
}

.status-card-error {
  background: #fdecec;
}

.status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0958a5;
}

.status-card-error .status-title,
.status-card-error .status-desc {
  color: #9b2c2c;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #0958a5;
}

.developer {
  padding: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b8bec9;
}

.page-shell .content {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  display: flex;
  align-items: stretch;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.content-scroll {
  flex: 1;
  width: 100%;
  height: 100%;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/*
 * 水印单独放在自适应容器里。
 * 使用 widthFix 只按可用宽度缩放，避免横向 Logo 在长屏/短屏上被裁切或异常放大。
 */
.watermark-wrap {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 34rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.watermark {
  display: block;
  width: 92%;
  max-width: 682rpx;
  flex-shrink: 0;
  opacity: 0.71;
}

.page-shell .footer {
  flex: 0 0 auto;
  width: 100%;
  padding: 18rpx 32rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.scan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 380rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  background: #1677df;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.scan-btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 26rpx;
  line-height: 1;
}
