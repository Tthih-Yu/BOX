# 仅监听回环地址，由 Nginx 提供公网 HTTPS。
RELAY_API_HOST=127.0.0.1
RELAY_API_PORT=18082
RELAY_API_DB=/var/lib/aliyun-api-relay/relay.db

# WinServer -> 阿里云 Worker/旧兼容接口凭证，至少 32 个字符。
RELAY_API_TOKEN=replace-with-worker-api-token-at-least-32-characters

# APP 首次登记使用的一次性/受控发放码，至少 32 个字符；不要硬编码到通用 APK。
RELAY_APP_ENROLLMENT_KEY=replace-with-enrollment-key-at-least-32-characters

RELAY_API_MAX_BODY=65536
RELAY_API_RESULT_MAX_BODY=262144
RELAY_COMMAND_LEASE_SECONDS=30
RELAY_COMMAND_TTL_SECONDS=120
RELAY_COMMAND_MAX_ATTEMPTS=3
RELAY_MAX_LONG_POLL_SECONDS=15
RELAY_DEVICE_RATE_LIMIT=30
