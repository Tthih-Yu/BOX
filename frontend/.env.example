# 前端网络配置示例。复制为 .env.local 后按部署环境修改，无需改代码。
# 换生产环境(IP/域名变化)时，一般只有下面几项需要关注。

# 开发服务器监听地址：127.0.0.1 仅本机；0.0.0.0 允许局域网访问(等价 npm run dev:lan)
VITE_DEV_HOST=127.0.0.1

# 开发服务器端口
VITE_DEV_PORT=5173

# 允许访问 dev 服务器的主机名/IP，逗号分隔。
# 留空或 all = 允许所有来源(内网开发最省心)；
# 生产/公网建议显式列出，例如：your-domain.com,10.0.0.5
VITE_ALLOWED_HOSTS=all

# /api 反向代理目标后端地址(仅 dev/preview 生效；生产由 nginx 代理，不用这项)
VITE_API_TARGET=http://localhost:8080

# 经反向代理/隧道访问时的 HMR 客户端端口，直连开发可留空
# VITE_HMR_CLIENT_PORT=80

# 应用标题/版本(可选)
# VITE_APP_TITLE=物料拉动系统
# VITE_APP_VERSION=V0.8.4-production
