# 物料拉动系统后端 systemd 服务配置。
# 安装或更新到 /etc/systemd/system 后需执行 systemctl daemon-reload。
[Unit]
Description=Material Pull System Backend
After=network-online.target mysql.service
# MySQL 升级会临时停止 mysql.service。使用 Wants 而不是 Requires，
# 避免 systemd 在数据库维护重启时连带停止后端且不再自动拉起。
Wants=network-online.target mysql.service

[Service]
Type=simple
User=tthih
Group=tthih
WorkingDirectory=/opt/apps/material-pull/backend
EnvironmentFile=/etc/material-pull/material-pull.env

ExecStart=/usr/lib/jvm/java-17-openjdk-amd64/bin/java \
  -jar /opt/apps/material-pull/backend/target/material-pull-system-backend-0.9.2.jar \
  --spring.profiles.active=mysql \
  --server.address=127.0.0.1

Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
